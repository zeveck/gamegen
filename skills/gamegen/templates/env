# API keys for the tools gamegen uses to make art and sound.
# Paste each key right after its = sign (no spaces, no quotes needed), save,
# and run /gamegen again.
#
# This file holds secrets. It's listed in .gitignore so it never gets
# committed; keep it that way.

# OpenAI, for characters, sprites and animations (imagegen2, anim8gen).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini, for backgrounds, scenery and items (nanogen).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs, for music and sound effects (audiogen).
# Get a key at https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=

# Optional, for 3D games only: Meshy, for 3D models and characters (meshgen).
# Get a key at https://www.meshy.ai under Settings > API (it needs a paid plan).
MESHY_API_KEY=

# Optional: your own defaults for publishing (/gamegen --publish). Remove the
# # to use one. The --publish, --gallery and --making-of flags override these.
# GAMEGEN_DOMAIN=example.com     # games go to <game>.example.com (or github.io)
# GAMEGEN_GALLERY=you/my-games   # a GitHub repo showing all your games together
# GAMEGEN_MAKING_OF=on           # READMEs show the prompts and how it was made
# GAMEGEN_CREDIT=Your Name       # who games credit (else your GitHub or git name)
